{
  "$description": "Watercolor Garden — design tokens extracted from the 'yaw & Lady' wedding site template (The Knot). W3C Design Tokens Community Group format.",
  "color": {
    "$type": "color",
    "neutral": {
      "paper":   { "$value": "#FFFFFF", "$description": "Page background. The dominant surface." },
      "ink":     { "$value": "#3A3A3A", "$description": "Primary text: couple names, section headings, nav. 11.37:1 on paper." },
      "ink-2":   { "$value": "#5E5E5E", "$description": "Secondary text: body copy, sub-dates, captions. 6.48:1 on paper." },
      "muted":   { "$value": "#8C8C8C", "$description": "LARGE TEXT (≥24px) OR NON-TEXT ONLY: placeholders at large size, input borders. 3.36:1 on paper — fails AA for body text." },
      "line":    { "$value": "#D9D6D3", "$description": "Decorative hairlines and section dividers only. 1.45:1 — never a functional boundary." }
    },
    "blush": {
      "50":  { "$value": "#FDF4EF", "$description": "Notice bar / soft panel background." },
      "200": { "$value": "#F3D3CD", "$description": "Petal pink; tinted chips, selected backgrounds." },
      "400": { "$value": "#D98E8A", "$description": "Decorative rose only. 2.57:1 on paper — never text, never a fill under text." }
    },
    "burgundy": {
      "600": { "$value": "#7A1F33", "$description": "Brand accent: primary buttons, links, focus ring. 10.14:1 with paper." },
      "700": { "$value": "#5E1726", "$description": "Primary button hover/active." }
    },
    "sage": {
      "400": { "$value": "#8EA787", "$description": "Leaf green, decorative only. 2.62:1 — fails for any text." },
      "700": { "$value": "#4F6B4A", "$description": "Text-safe green: success messages, 'attending' states. 5.94:1 on paper." }
    },
    "semantic": {
      "background":      { "$value": "{color.neutral.paper}" },
      "surface-soft":    { "$value": "{color.blush.50}" },
      "text-primary":    { "$value": "{color.neutral.ink}" },
      "text-secondary":  { "$value": "{color.neutral.ink-2}" },
      "text-on-accent":  { "$value": "{color.neutral.paper}" },
      "accent":          { "$value": "{color.burgundy.600}" },
      "accent-hover":    { "$value": "{color.burgundy.700}" },
      "border-input":    { "$value": "{color.neutral.muted}" },
      "border-divider":  { "$value": "{color.neutral.line}" },
      "success":         { "$value": "{color.sage.700}" },
      "error":           { "$value": "#A3261F", "$description": "Brick red, 7.36:1 on paper; distinct in lightness from burgundy accent when paired with an icon." },
      "focus-ring":      { "$value": "{color.burgundy.600}" }
    }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "script": { "$value": ["Great Vibes", "Pinyon Script", "cursive"], "$description": "Couple names / monogram only. Closest open match to the template's calligraphic script." },
      "serif":  { "$value": ["Source Serif 4", "Georgia", "serif"], "$description": "Everything else: headings, nav, body, buttons." }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": { "$value": 400 },
      "semibold": { "$value": 600 }
    }
  },
  "typography": {
    "$type": "typography",
    "display-script": { "$value": { "fontFamily": "{font.family.script}", "fontSize": "88px", "fontWeight": 400, "lineHeight": 1.1, "letterSpacing": "0px" } },
    "eyebrow-date":   { "$value": { "fontFamily": "{font.family.serif}",  "fontSize": "24px", "fontWeight": 400, "lineHeight": 1.3, "letterSpacing": "0.18em" }, "$description": "UPPERCASE" },
    "heading-1":      { "$value": { "fontFamily": "{font.family.serif}",  "fontSize": "40px", "fontWeight": 400, "lineHeight": 1.2, "letterSpacing": "0.16em" }, "$description": "UPPERCASE section titles, e.g. WEDDING DAY" },
    "heading-2":      { "$value": { "fontFamily": "{font.family.serif}",  "fontSize": "28px", "fontWeight": 400, "lineHeight": 1.3, "letterSpacing": "0.04em" } },
    "nav":            { "$value": { "fontFamily": "{font.family.serif}",  "fontSize": "20px", "fontWeight": 400, "lineHeight": 1.4, "letterSpacing": "0.12em" }, "$description": "Title Case" },
    "body":           { "$value": { "fontFamily": "{font.family.serif}",  "fontSize": "18px", "fontWeight": 400, "lineHeight": 1.65, "letterSpacing": "0.01em" } },
    "caption":        { "$value": { "fontFamily": "{font.family.serif}",  "fontSize": "15px", "fontWeight": 400, "lineHeight": 1.5, "letterSpacing": "0.08em" } },
    "button":         { "$value": { "fontFamily": "{font.family.serif}",  "fontSize": "16px", "fontWeight": 600, "lineHeight": 1, "letterSpacing": "0.14em" }, "$description": "UPPERCASE" }
  },
  "spacing": {
    "$type": "dimension",
    "1":  { "$value": "4px" },
    "2":  { "$value": "8px" },
    "3":  { "$value": "12px" },
    "4":  { "$value": "16px" },
    "5":  { "$value": "24px" },
    "6":  { "$value": "32px" },
    "7":  { "$value": "48px" },
    "8":  { "$value": "64px" },
    "9":  { "$value": "96px" },
    "10": { "$value": "128px" },
    "gutter-mobile": { "$value": "20px" },
    "section-gap":   { "$value": "{spacing.10}" },
    "content-max":   { "$value": "1120px" },
    "reading-max":   { "$value": "680px" }
  },
  "borderRadius": {
    "$type": "dimension",
    "none": { "$value": "0px", "$description": "Default for cards, images, panels." },
    "sm":   { "$value": "2px", "$description": "Inputs." },
    "pill": { "$value": "999px", "$description": "Buttons and chips." }
  },
  "borderWidth": {
    "$type": "dimension",
    "hairline": { "$value": "1px" },
    "nav-underline": { "$value": "2px" }
  },
  "shadow": {
    "$type": "shadow",
    "none": { "$value": { "color": "#00000000", "offsetX": "0px", "offsetY": "0px", "blur": "0px", "spread": "0px" }, "$description": "Default. The style is flat." },
    "float": { "$value": { "color": "#3A3A3A1F", "offsetX": "0px", "offsetY": "4px", "blur": "16px", "spread": "0px" }, "$description": "Floating actions only (e.g. an edit/RSVP pill fixed to the viewport)." },
    "overlay": { "$value": { "color": "#3A3A3A29", "offsetX": "0px", "offsetY": "12px", "blur": "40px", "spread": "0px" }, "$description": "Modals and dropdown menus." }
  },
  "motion": {
    "duration": { "$type": "duration", "fast": { "$value": "150ms" }, "base": { "$value": "250ms" } },
    "easing": { "$type": "cubicBezier", "standard": { "$value": [0.2, 0, 0, 1] } }
  }
}