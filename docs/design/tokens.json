{
  "$description": "Nhyira design tokens. Two surfaces share one set of semantic names: 'guest' (warm garden invitation, from the approved R1 screens) and 'organiser' (Watercolor Garden, from docs/design/source). app/globals.css implements this file; when they disagree, this file wins. W3C Design Tokens format.",
  "surface": {
    "guest": {
      "$description": "Invite, RSVP, thanks, closed, not-found, home and the WhatsApp preview. Warm cream paper, burgundy accent, editorial italic display.",
      "color": {
        "$type": "color",
        "paper":        { "$value": "#FBF7F0", "$description": "Page background." },
        "panel":        { "$value": "#F3E9DA", "$description": "RSVP panel, notices, seat groups sit on paper inside it." },
        "field":        { "$value": "#FFFFFF", "$description": "Inputs and choice cards." },
        "ink":          { "$value": "#2B2321", "$description": "Primary text. 14.41:1 on paper." },
        "ink-2":        { "$value": "#5A4E48", "$description": "Body copy, meta, captions. 7.51:1 on paper, 6.68:1 on panel." },
        "placeholder":  { "$value": "#6B5E57", "$description": "Input placeholder. 6.24:1 on white." },
        "border":       { "$value": "#9A8D84", "$description": "Input and choice-card boundary. 3.02:1 on paper (non-text 3:1 rule)." },
        "line":         { "$value": "#DCCFBF", "$description": "Decorative rules between events, photo placeholder fill. 1.43:1, decor only." },
        "accent":       { "$value": "#6E1423", "$description": "Buttons, links, selected choice, badges. 11.0:1 on paper." },
        "accent-hover": { "$value": "#560F1B", "$description": "Button and link hover." },
        "on-accent":    { "$value": "#FBF7F0", "$description": "Text on accent fills." },
        "eyebrow":      { "$value": "#8A6A3B", "$description": "Antique gold, uppercase eyebrow labels only. 4.68:1." },
        "script":       { "$value": "#9C5D6E", "$description": "Dusty rose, Great Vibes greeting lines only (≥30px). 4.68:1." },
        "success":      { "$value": "#4F6B4A", "$description": "Attending names. 5.56:1." },
        "success-tint": { "$value": "#E7EEE5" },
        "error":        { "$value": "#A3261F", "$description": "Errors with an icon. 6.89:1 on paper, 6.12:1 on panel." },
        "error-tint":   { "$value": "#F8E3E0" },
        "quiet-tint":   { "$value": "#ECE3D6", "$description": "Neutral badge on paper." },
        "scrim":        { "$value": "#2B2321", "$description": "Photo scrim base: 0 → 55% → 82% opacity, bottom-up." }
      }
    },
    "organiser": {
      "$description": "Sign in, link sent, expired link, dashboard. Watercolor Garden: white paper, charcoal ink, one burgundy accent.",
      "color": {
        "$type": "color",
        "paper":        { "$value": "#FFFFFF" },
        "panel":        { "$value": "#FDF4EF", "$description": "blush-50: empty states, highlighted row." },
        "field":        { "$value": "#FFFFFF" },
        "ink":          { "$value": "#3A3A3A", "$description": "11.37:1." },
        "ink-2":        { "$value": "#5E5E5E", "$description": "6.48:1." },
        "placeholder":  { "$value": "#5E5E5E" },
        "border":       { "$value": "#8C8C8C", "$description": "Inputs and chips. 3.36:1. Never for text under 24px." },
        "line":         { "$value": "#D9D6D3", "$description": "Row dividers, decor only." },
        "accent":       { "$value": "#7A1F33", "$description": "Primary button, links, focus. 10.14:1." },
        "accent-hover": { "$value": "#5E1726" },
        "on-accent":    { "$value": "#FFFFFF" },
        "eyebrow":      { "$value": "#5E5E5E" },
        "script":       { "$value": "#3A3A3A", "$description": "Couple names in Great Vibes." },
        "success":      { "$value": "#4F6B4A", "$description": "Attending badge text, WhatsApp button." },
        "success-tint": { "$value": "#E7EEE5", "$description": "Attending badge, link-sent notice. Success on it 5.02:1." },
        "error":        { "$value": "#A3261F" },
        "error-tint":   { "$value": "#F8E3E0", "$description": "Declined badge, expired notice. Error on it 5.98:1." },
        "quiet-tint":   { "$value": "#F1EFED", "$description": "No-reply badge. ink-2 on it 5.65:1." }
      }
    }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "display": { "$value": ["Cormorant Garamond", "Georgia", "serif"], "$description": "Guest headings, couple names, event names. Usually italic 300." },
      "script":  { "$value": ["Great Vibes", "cursive"], "$description": "The ampersand, guest greeting lines, organiser couple names. One script line per screen." },
      "serif":   { "$value": ["Source Serif 4", "Georgia", "serif"], "$description": "Body, labels, buttons, the whole organiser UI." }
    },
    "weight": { "$type": "fontWeight", "light": { "$value": 300 }, "regular": { "$value": 400 }, "medium": { "$value": 500 }, "semibold": { "$value": 600 } }
  },
  "typography": {
    "$type": "typography",
    "guest": {
      "hero-names":   { "$value": { "fontFamily": "{font.family.display}", "fontSize": "68px", "fontWeight": 300, "fontStyle": "italic", "lineHeight": 0.95 } },
      "page-title":   { "$value": { "fontFamily": "{font.family.display}", "fontSize": "42px", "fontWeight": 300, "fontStyle": "italic", "lineHeight": 1.05 } },
      "event-name":   { "$value": { "fontFamily": "{font.family.display}", "fontSize": "30px", "fontWeight": 400, "lineHeight": 1.1 } },
      "legend":       { "$value": { "fontFamily": "{font.family.display}", "fontSize": "24px", "fontWeight": 500, "lineHeight": 1.2 } },
      "greeting":     { "$value": { "fontFamily": "{font.family.script}",  "fontSize": "40px", "fontWeight": 400, "lineHeight": 1.1 } },
      "eyebrow":      { "$value": { "fontFamily": "{font.family.serif}",   "fontSize": "12px", "fontWeight": 400, "letterSpacing": "0.3em" }, "$description": "UPPERCASE" },
      "date-line":    { "$value": { "fontFamily": "{font.family.serif}",   "fontSize": "14px", "fontWeight": 400, "letterSpacing": "0.4em" }, "$description": "13 · 02 · 2027" },
      "body":         { "$value": { "fontFamily": "{font.family.serif}",   "fontSize": "17px", "fontWeight": 400, "lineHeight": 1.6 } },
      "meta":         { "$value": { "fontFamily": "{font.family.serif}",   "fontSize": "15px", "fontWeight": 400, "lineHeight": 1.6 } },
      "label":        { "$value": { "fontFamily": "{font.family.serif}",   "fontSize": "12px", "fontWeight": 400, "letterSpacing": "0.14em" }, "$description": "UPPERCASE" },
      "badge":        { "$value": { "fontFamily": "{font.family.serif}",   "fontSize": "11px", "fontWeight": 400, "letterSpacing": "0.16em" }, "$description": "UPPERCASE" },
      "button":       { "$value": { "fontFamily": "{font.family.serif}",   "fontSize": "15px", "fontWeight": 600, "letterSpacing": "0.2em" }, "$description": "UPPERCASE" }
    },
    "organiser": {
      "couple-names": { "$value": { "fontFamily": "{font.family.script}", "fontSize": "44px", "fontWeight": 400, "lineHeight": 1.1 }, "$description": "56px on desktop" },
      "page-title":   { "$value": { "fontFamily": "{font.family.serif}",  "fontSize": "22px", "fontWeight": 400, "letterSpacing": "0.16em" }, "$description": "UPPERCASE" },
      "stat":         { "$value": { "fontFamily": "{font.family.serif}",  "fontSize": "32px", "fontWeight": 400, "lineHeight": 1 }, "$description": "44px on desktop" },
      "body":         { "$value": { "fontFamily": "{font.family.serif}",  "fontSize": "17px", "fontWeight": 400, "lineHeight": 1.6 } },
      "label":        { "$value": { "fontFamily": "{font.family.serif}",  "fontSize": "14px", "fontWeight": 400, "letterSpacing": "0.08em" }, "$description": "UPPERCASE" },
      "column-head":  { "$value": { "fontFamily": "{font.family.serif}",  "fontSize": "13px", "fontWeight": 400, "letterSpacing": "0.12em" }, "$description": "UPPERCASE" },
      "button":       { "$value": { "fontFamily": "{font.family.serif}",  "fontSize": "16px", "fontWeight": 600, "letterSpacing": "0.14em" }, "$description": "UPPERCASE" }
    }
  },
  "size": {
    "$type": "dimension",
    "control-guest":     { "$value": "56px", "$description": "Buttons and choice cards on guest screens." },
    "control-organiser": { "$value": "52px" },
    "input":             { "$value": "52px" },
    "touch-min":         { "$value": "44px" },
    "gutter-guest":      { "$value": "28px" },
    "gutter-organiser":  { "$value": "20px" },
    "reading-max":       { "$value": "680px" },
    "content-max":       { "$value": "1200px" }
  },
  "borderRadius": {
    "$type": "dimension",
    "none":  { "$value": "0px",   "$description": "Photos, panels, cards." },
    "input": { "$value": "2px" },
    "pill":  { "$value": "999px", "$description": "Buttons, chips, badges." }
  },
  "shadow": {
    "$type": "shadow",
    "float":   { "$value": { "color": "#3A3A3A1F", "offsetX": "0px", "offsetY": "4px",  "blur": "16px", "spread": "0px" } },
    "overlay": { "$value": { "color": "#3A3A3A29", "offsetX": "0px", "offsetY": "12px", "blur": "40px", "spread": "0px" } }
  },
  "motion": {
    "duration": { "$type": "duration", "fast": { "$value": "150ms" }, "base": { "$value": "250ms" } },
    "easing":   { "$type": "cubicBezier", "standard": { "$value": [0.2, 0, 0, 1] } }
  }
}
